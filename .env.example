# Required — powers the /terminal AI chat (src/app/api/chat/route.ts)
ANTHROPIC_API_KEY=

# Optional — distributed rate limiting for the chat endpoint.
# If unset, the app falls back to an in-memory limiter (see src/lib/ratelimit.ts).
# The Vercel Marketplace Upstash install provides these as KV_REST_API_URL /
# KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
